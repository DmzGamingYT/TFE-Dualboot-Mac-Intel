# ── Auto detect text files and normalise line endings (LF) ──
* text=auto eol=lf

# ── Text files ──
*.html  text diff=html eol=lf
*.css   text diff=css eol=lf
*.js    text diff=javascript eol=lf
*.json  text diff=json eol=lf
*.md    text diff=markdown eol=lf
*.svg   text diff=xml eol=lf
*.xml   text diff=xml eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf

# ── Binary files (no diff, no line-ending conversion) ──
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
